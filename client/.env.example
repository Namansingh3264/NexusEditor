# ---------------------------------------------------------------------------
# Client (Next.js) environment
# Copy to `client/.env` for local development, or set these in your hosting
# provider (Vercel: Project Settings -> Environment Variables).
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Managed Postgres (Neon/Supabase/RDS) usually
# requires sslmode=require.
DATABASE_URL="postgresql://user:password@host:5432/nexuseditor?sslmode=require"

# Signing key for NextAuth session tokens. REQUIRED in production.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Public URL of this app. Must match the deployed origin exactly,
# e.g. https://nexuseditor.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Public URL of the collaboration server (the /server app).
# Exposed to the browser, so it must be publicly reachable in production,
# e.g. https://nexuseditor-collab.onrender.com
NEXT_PUBLIC_WEBSOCKET_URL="http://localhost:8080"
