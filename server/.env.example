# ---------------------------------------------------------------------------
# Collaboration server environment
# Copy to `server/.env` for local development, or set these on your host
# (Render / Railway / Fly / any Node host).
# ---------------------------------------------------------------------------

# Same PostgreSQL database as the client.
DATABASE_URL="postgresql://user:password@host:5432/nexuseditor?sslmode=require"

# Allowed browser origin(s) for CORS and Socket.IO.
# Comma-separate to allow several (e.g. production plus preview deployments).
CLIENT_URL="http://localhost:3000"

# Port to listen on. Most platforms inject this automatically.
PORT=8080
